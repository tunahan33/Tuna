# GS Projeler — Apache yapılandırması
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # HTTPS zorunlu (SSL sertifikası kurulduktan sonra Sanal POS için gereklidir)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Uygulama ve veri klasörlerine doğrudan erişimi engelle
  RewriteRule ^(app|data)(/|$) - [F,L]
  RewriteRule (^|/)\. - [F,L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.php [QSA,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
</IfModule>

<FilesMatch "\.(sqlite|sqlite-wal|sqlite-shm|md|log)$">
  Require all denied
</FilesMatch>
